rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidOeeRecord(data) {
      return data.keys().hasAll(['id', 'machine', 'datetime', 'operator']) &&
             data.keys().hasOnly(['id', 'machine', 'datetime', 'reportDate', 'shift', 'shiftType', 'operator', 'speed', 'speedStd', 'speedSet', 'targetKg', 'actualKg', 'goodKg', 'rejectKg', 'breakdownMin', 'notes', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.machine is string && data.machine.size() <= 100 &&
             data.datetime is string && data.datetime.size() <= 64 &&
             data.operator is string && data.operator.size() <= 100;
    }

    function isValidSealTempRecord(data) {
      return data.keys().hasAll(['id', 'machine', 'datetime', 'operator']) &&
             data.keys().hasOnly(['id', 'machine', 'datetime', 'reportDate', 'shift', 'shiftType', 'operator', 'tempFront', 'tempBack', 'tempMid', 'lot', 'teflon', 'packSealTop', 'packSealMid', 'packSealBot', 'hole', 'notes', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.machine is string && data.machine.size() <= 100 &&
             data.datetime is string && data.datetime.size() <= 64 &&
             data.operator is string && data.operator.size() <= 100;
    }

    function isValidFilmRollRecord(data) {
      return data.keys().hasAll(['id', 'machine', 'datetime', 'operator', 'supplier']) &&
             data.keys().hasOnly(['id', 'machine', 'datetime', 'filmDate', 'shift', 'shiftType', 'operator', 'supplier', 'changeTime', 'tagPhoto', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.machine is string && data.machine.size() <= 100 &&
             data.datetime is string && data.datetime.size() <= 64 &&
             data.operator is string && data.operator.size() <= 100 &&
             data.supplier is string && data.supplier.size() <= 50;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /oee_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidOeeRecord(request.resource.data);
      allow delete: if true;
    }

    match /seal_temp_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidSealTempRecord(request.resource.data);
      allow delete: if true;
    }

    match /film_roll_records/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId) && isValidFilmRollRecord(request.resource.data);
      allow delete: if true;
    }
  }
}
